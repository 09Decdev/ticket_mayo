# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/ticket_mayo

# Auth (ticket-mayo owns end-user JWT — HS256, 7d expiry)
JWT_SECRET=dev-jwt-secret-rotate-in-prod-min-32-chars
ADMIN_EMAIL=admin@ticket-mayo.local
ADMIN_PASSWORD=admin-password-rotate-in-prod

# Email binding (HMAC pepper — blind index binding PreTicket <-> PortalUser)
FIELD_ENCRYPTION_PEPPER=dev-pepper-32bytes-please-rotate-in-prod

# Mail dispatch: "console" (logs claim links) | "kafka" | "smtp" (real email)
MAIL_TRANSPORT=console
KAFKA_BROKERS=

# SMTP relay (Gmail app password) — used when MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=you@gmail.com
MAIL_PASS=your-gmail-app-password
MAIL_FROM=you@gmail.com

# Public base URL for claim links (frontend ticket portal)
PUBLIC_BASE_URL=http://localhost:5174

# Universal link base cho nhận vé — app đã cài tự mở & claim bằng token;
# chưa cài thì browser load /c/<token> và hiện trang tải app. Mặc định = PUBLIC_BASE_URL.
# Prod đặt = domain đã cấu hình apple-app-site-association / assetlinks.
APP_UNIVERSAL_LINK_BASE=

# Link BTC cập nhật sự kiện — đặt trong body text email vé ("Theo dõi các
# cập nhật mới nhất của BTC tại: ..."). Trống → fallback universal link.
BTC_UPDATE_URL=

# Public base URL của backend API — GIỮ CHO ADMIN/DEBUG NỘI BỘ (email không
# còn trỏ vào đây; nút "Tải vé PDF" trỏ content — xem CONTENT_PUBLIC_BASE_URL).
TICKET_MAYO_BASE_URL=

# Content-service — nguồn sự thật event/ticket (internal API x-service-token)
# INTERNAL_SERVICE_TOKEN phải khớp chính xác value của content-service (.env)
CONTENT_SERVICE_BASE_URL=http://localhost:30041
INTERNAL_SERVICE_TOKEN=

# Base URL PUBLIC của content-service — người nhận vé bấm link từ email
# (PDF render TẠI content, verify bằng signed token). Trống → nút PDF trong
# email fallback về link claim. Prod bắt buộc, vd https://api.mayogu.com
CONTENT_PUBLIC_BASE_URL=

# Khóa ký HMAC-SHA256 recipient cho mint API (Δ11) — BẮT BUỘC: mọi đợt
# phát vé đều mint ngay trong distribute() TRƯỚC khi gửi email (email chỉ
# gửi sau khi vé đã trừ ở content). Yêu cầu:
#   - ≥ 32 ký tự (sinh bằng: openssl rand -hex 32)
#   - PHẢI TRÙNG value MINT_SIGNING_KEY của content-service
#   - KHÔNG reuse INTERNAL_SERVICE_TOKEN (khóa ký ≠ khóa auth — tách biệt
#     để rotate độc lập và tránh 1 key leak phá 2 cơ chế)
MINT_SIGNING_KEY=

# User-community-service — tra displayName người nhận vé qua lookup-by-emails.
# Dùng chung INTERNAL_SERVICE_TOKEN ở trên (x-service-token). Mặc định port 3001.
USER_COMMUNITY_BASE_URL=http://localhost:3001

# SeaweedFS S3 — bucket PRIVATE lưu PDF vé luồng bắn email (PDF chứa PII người
# nhận, chỉ nội bộ đọc được). Thiếu 1 trong 3 key dưới → tính năng lưu PDF TẮT
# (email vẫn gửi bình thường). Cùng hạ tầng với upload-service (port S3 :8333).
# credentials = identity trong deployment/config/seaweedfs/s3.json.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_TICKET_PDF_BUCKET=ticket-email-pdfs

# Nội dung thương hiệu in trong email vé (fallback đã có default; prod thay bằng
# URL HTTPS thật: logo/icon/banner trên CDN, link App Store / Google Play).
# BRAND_LOGO_URL rỗng → tự nhúng img/Logo_xoa_phong 2.png base64. Prod đặt HTTPS CDN.
SUPPORT_EMAIL=support@mayogu.com
SUPPORT_PHONE=0966 855 560
BRAND_LOGO_URL=
NOTICE_ICON_URL=
DEFAULT_BANNER_URL=
APP_STORE_URL=
GOOGLE_PLAY_URL=

# Service
PORT=3005
NODE_ENV=development
